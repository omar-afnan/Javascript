let raceNumber = Math.floor(Math.random() * 1000);


let registeredEarly = true;

const runnerAge = 30;



if(runnerAge > 18  && registeredEarly )
{
 raceNumber += 1000;
}


 if ( runnerAge > 18 &&  registeredEarly )
 {
   console.log(`The race for the runner above 18 will start at 9:30 am. Your race number is ${raceNumber}`);
 }
else if ( runnerAge > 18 && !registeredEarly)
{
  console.log(`Adult runner registered late. Your race starts at 11:00 am. Your race number is ${raceNumber}`);
}
else if (runnerAge < 18)
{
   console.log(`Youth runner. Your race starts at 12:30 pm. Your race number is ${raceNumber}`);
}
else
{
  console.log("go to the registration desk");
} 
